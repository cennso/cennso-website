{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cennso Website - Meta Tag Templates",
  "description": "Reusable meta tag patterns for SEO, Open Graph, and Twitter Cards",
  "version": "1.0.0",
  "templates": {
    "titleTemplates": {
      "default": {
        "pattern": "{pageName} · Cennso",
        "description": "Every page: its name, then the site's name - the documentation portal's pattern (\"{chapter} · Cennso Documentation\"). <SEO title> takes the page name and adds the suffix.",
        "maxLength": 60,
        "lengthIsWarning": true,
        "examples": [
          "Contact · Cennso",
          "Success Stories · Cennso",
          "Privacy Policy · Cennso"
        ]
      },
      "home": {
        "pattern": "Cennso · {tagline}",
        "description": "The home page sets its whole title with <SEO absoluteTitle>; it starts with the site's name",
        "maxLength": 60,
        "lengthIsWarning": true,
        "examples": ["Cennso · 5G Network Solutions for MVNOs and Private 5G"]
      },
      "blogPost": {
        "pattern": "{postTitle} · Cennso",
        "description": "Blog post title format",
        "maxLength": 60,
        "lengthIsWarning": true,
        "examples": ["Getting Started with Next.js · Cennso"]
      },
      "solution": {
        "pattern": "{solutionName} · Cennso",
        "description": "Solution page title format",
        "maxLength": 60,
        "lengthIsWarning": true,
        "examples": ["Private 5G · Cennso"]
      },
      "jobPosting": {
        "pattern": "{jobTitle} · Cennso",
        "description": "Job posting title format",
        "maxLength": 60,
        "lengthIsWarning": true,
        "examples": ["Senior Developer · Cennso"]
      },
      "successStory": {
        "pattern": "{storyTitle} · Cennso",
        "description": "Success story title format; story titles run long, which is a warning only",
        "maxLength": 60,
        "lengthIsWarning": true,
        "examples": [
          "Crossing borders without missing a beat: Cennso and IBM · Cennso"
        ]
      }
    },
    "descriptionTemplates": {
      "default": {
        "pattern": "{pageDescription}",
        "description": "Standard meta description",
        "minLength": 50,
        "maxLength": 160,
        "guidelines": [
          "Include primary keyword naturally",
          "Add clear call-to-action",
          "Focus on user benefit",
          "Avoid keyword stuffing"
        ],
        "lengthIsWarning": true
      },
      "home": {
        "pattern": "{companyDescription} {services} {cta}",
        "description": "Homepage meta description",
        "minLength": 50,
        "maxLength": 160,
        "examples": [
          "Cennso provides expert IT consulting services including cloud migration, DevOps automation, and digital transformation. Contact us today for a free consultation."
        ],
        "lengthIsWarning": true
      },
      "blogPost": {
        "pattern": "{excerpt} Read more on the Cennso blog.",
        "description": "Blog post meta description",
        "minLength": 50,
        "maxLength": 160,
        "lengthIsWarning": true
      },
      "solution": {
        "pattern": "Learn how Cennso's {solutionName} services help businesses {benefit}. {cta}",
        "description": "Solution page meta description",
        "minLength": 50,
        "maxLength": 160,
        "examples": [
          "Learn how Cennso's cloud migration services help businesses reduce costs and improve scalability. Schedule a consultation today."
        ],
        "lengthIsWarning": true
      },
      "jobPosting": {
        "pattern": "Join Cennso as a {jobTitle} in {location}. {keyResponsibility} {benefit}",
        "description": "Job posting meta description",
        "minLength": 50,
        "maxLength": 160,
        "examples": [
          "Join Cennso as a Senior Developer in Berlin. Build cutting-edge solutions for enterprise clients. Competitive salary and remote work options."
        ],
        "lengthIsWarning": true
      }
    },
    "openGraphTemplates": {
      "article": {
        "required": [
          "og:type",
          "og:title",
          "og:description",
          "og:image",
          "og:url"
        ],
        "properties": {
          "og:type": "article",
          "og:title": "{pageName}",
          "og:description": "{excerpt}",
          "og:image": "{cardUrl}?v={cardTextHash}",
          "og:image:alt": "{cardText}",
          "og:image:width": "1200",
          "og:image:height": "630",
          "og:url": "{canonicalUrl}",
          "og:site_name": "Cennso",
          "article:published_time": "{publishDate}",
          "article:modified_time": "{modifiedDate}",
          "article:author": "{authorUrl}",
          "article:section": "{category}",
          "article:tag": "{tags}",
          "og:image:type": "image/png"
        }
      },
      "website": {
        "required": [
          "og:type",
          "og:title",
          "og:description",
          "og:image",
          "og:url"
        ],
        "properties": {
          "og:type": "website",
          "og:title": "{pageName}",
          "og:description": "{pageDescription}",
          "og:image": "{cardUrl}?v={cardTextHash}",
          "og:image:alt": "{cardText}",
          "og:image:width": "1200",
          "og:image:height": "630",
          "og:url": "{canonicalUrl}",
          "og:site_name": "Cennso",
          "og:locale": "en_US",
          "og:image:type": "image/png"
        }
      },
      "profile": {
        "required": ["og:type", "og:title", "og:image", "og:url"],
        "properties": {
          "og:type": "profile",
          "og:title": "{pageName}",
          "og:description": "{authorBio}",
          "og:image": "{cardUrl}?v={cardTextHash}",
          "og:url": "{authorProfileUrl}",
          "profile:first_name": "{firstName}",
          "profile:last_name": "{lastName}",
          "profile:username": "{username}",
          "og:image:type": "image/png",
          "og:image:alt": "{cardText}"
        }
      }
    },
    "twitterCardTemplates": {
      "summaryLargeImage": {
        "required": ["twitter:card"],
        "properties": {
          "twitter:card": "summary_large_image"
        },
        "imageRequirements": {
          "aspectRatio": "2:1",
          "minWidth": 300,
          "minHeight": 157,
          "maxSize": "5MB",
          "formats": ["JPG", "PNG", "WebP", "GIF"]
        },
        "description": "No X account: only the card type is written; X reads title, description and image from the Open Graph tags"
      },
      "summary": {
        "required": ["twitter:card", "twitter:title", "twitter:description"],
        "properties": {
          "twitter:card": "summary",
          "twitter:site": "@cennso",
          "twitter:title": "{pageTitle}",
          "twitter:description": "{pageDescription}",
          "twitter:image": "{twitterImageUrl}",
          "twitter:image:alt": "{imageAltText}"
        },
        "imageRequirements": {
          "aspectRatio": "1:1",
          "minWidth": 144,
          "minHeight": 144,
          "maxSize": "5MB",
          "formats": ["JPG", "PNG", "WebP", "GIF"]
        }
      }
    },
    "robotsMetaTemplates": {
      "default": {
        "content": "index, follow, max-snippet:-1, max-image-preview:large",
        "description": "Allow indexing, a snippet of any length and a large image preview"
      },
      "noindex": {
        "content": "noindex, follow",
        "description": "Block indexing but allow following links",
        "useCases": ["Draft content", "Test pages", "Internal tools"]
      },
      "nofollow": {
        "content": "index, nofollow",
        "description": "Allow indexing but don't follow links",
        "useCases": ["User-generated content pages"]
      },
      "none": {
        "content": "noindex, nofollow",
        "description": "Block indexing and following links",
        "useCases": ["Private pages", "Admin panels"]
      },
      "maxSnippet": {
        "content": "max-snippet:160",
        "description": "Limit search result snippet to 160 characters"
      },
      "maxImagePreview": {
        "content": "max-image-preview:large",
        "description": "Allow large image previews in search results"
      }
    },
    "canonicalUrlTemplates": {
      "production": {
        "baseUrl": "https://www.cennso.com",
        "pattern": "{baseUrl}{pagePath}",
        "homePage": "https://www.cennso.com/",
        "description": "The home page with its slash (as new URL('/', base) serialises it, and as the documentation and cloud portals name this site); every other page without one. The 404 page has none and is noindex.",
        "examples": [
          "https://www.cennso.com/",
          "https://www.cennso.com/contact",
          "https://www.cennso.com/success-stories/cennso-on-ibm-cloud"
        ]
      },
      "preview": {
        "baseUrl": "{VERCEL_URL}",
        "pattern": "https://{baseUrl}{pagePath}",
        "description": "Dynamic canonical for Vercel preview deployments"
      }
    },
    "languageAlternatesTemplates": {
      "default": {
        "pattern": "<link rel=\"alternate\" hreflang=\"{langCode}\" href=\"{url}\" />",
        "examples": [
          "<link rel=\"alternate\" hreflang=\"en\" href=\"https://www.cennso.com/about\" />",
          "<link rel=\"alternate\" hreflang=\"de\" href=\"https://www.cennso.com/de/about\" />",
          "<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://www.cennso.com/about\" />"
        ]
      }
    },
    "additionalMetaTags": {
      "viewport": {
        "name": "viewport",
        "content": "width=device-width, initial-scale=1"
      },
      "themeColor": {
        "name": "theme-color",
        "content": "hsl(<theme --background>)",
        "media": "(prefers-color-scheme: light|dark)",
        "description": "One per theme, each under the system setting that picks it; replaced by the chosen theme's colour once the page is interactive. Plus <meta name=\"color-scheme\" content=\"light dark\">."
      },
      "author": {
        "name": "author",
        "content": "Cennso"
      },
      "referrer": {
        "name": "referrer",
        "content": "origin-when-cross-origin"
      },
      "formatDetection": {
        "name": "format-detection",
        "content": "telephone=no"
      }
    }
  },
  "validationRules": {
    "titleLength": {
      "max": 60,
      "severity": "warning"
    },
    "descriptionLength": {
      "min": 50,
      "max": 160,
      "severity": "warning"
    },
    "ogImageDimensions": {
      "width": 1200,
      "height": 630,
      "aspectRatio": "1.91:1"
    },
    "twitterImageDimensions": {
      "summaryLargeImage": {
        "width": 1200,
        "height": 628,
        "aspectRatio": "2:1"
      },
      "summary": {
        "width": 300,
        "height": 300,
        "aspectRatio": "1:1"
      }
    },
    "urlFormat": {
      "protocol": "https",
      "trailingSlash": "home page only",
      "lowercase": true,
      "specialCharacters": false
    }
  },
  "fallbackValues": {
    "defaultOgImage": "none: every page has its own generated card",
    "defaultDescription": "Cennso provides expert IT consulting services to help businesses innovate and grow through technology.",
    "siteName": "Cennso",
    "locale": "en_US"
  }
}
